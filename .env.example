# Valores privados: completar solo en .env.local, nunca en Git.
DATABASE_URL=postgresql://REEMPLAZAR
DATABASE_URL_UNPOOLED=postgresql://REEMPLAZAR
NEON_AUTH_BASE_URL=https://REEMPLAZAR/auth
NEON_AUTH_JWKS_URL=https://REEMPLAZAR/.well-known/jwks.json
# URL pública de la API: /api en desarrollo, HTTPS para GitHub Pages y Android.
VITE_API_URL=/api
PUBLIC_BASE=/
